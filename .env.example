# ============================================================
# 環境変数一覧（ローカルは .env にコピーして使用。ホスティングでは管理画面で設定）
# すべて任意。未設定でもビルド・表示できる。
# ============================================================

# ---- サイトURL・配信 ----
# 本番の正規URL（canonical / OGP / sitemap / robots.txt に使用）。末尾スラッシュなし。
# 未設定時: Vercel・Netlify は本番URLを自動使用、それ以外は http://localhost:4321
# 独自ドメインへ移行するときはここを変えて再ビルドする。
SITE_URL=
# サブディレクトリ配信時のみ（例: /hamamatsu）。通常は空。
BASE_PATH=

# ---- 対象都市 ----
# src/config/cities.ts の citySlug。未設定時は hamamatsu
CITY=

# ---- インデックス制御 ----
# true にすると robots.txt を全体 Disallow、全ページ noindex にする（検証環境向け）。
# Vercel のプレビュー / Netlify のデプロイプレビュー / Cloudflare Pages の本番以外のブランチは自動で true。
NOINDEX=
# Cloudflare Pages の本番ブランチ名（既定 main）。これ以外のブランチのビルドは noindex
PRODUCTION_BRANCH=

# ---- 計測 ----
# GA4 の測定ID。未設定なら G-DDP1G874JS（astro.config.mjs の既定値）。送客クリックは 'outbound_click' で送信
# PUBLIC_GA4_ID=G-DDP1G874JS
# 送客ログの送信先（例: /api/log）。設定すると navigator.sendBeacon で送信
PUBLIC_LOG_ENDPOINT=

# ---- 最終更新年月 ----
# 「最終更新: YYYY年MM月」はビルド実行時の年月（日本時間）が自動で入る。通常は空のまま。
# 検証や再現ビルドで日付を固定したい場合のみ指定（例: 2026-10-01）
BUILD_DATE=
