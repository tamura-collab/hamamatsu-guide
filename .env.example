# 本番の正規URL（canonical / OGP / sitemap に使用）。末尾スラッシュなし。
# 未設定時: Vercel では本番URLを自動使用、ローカルでは http://localhost:4321
SITE_URL=
# サブディレクトリ配信時のみ設定（例: /media）。通常は空でOK。
BASE_PATH=
# 対象都市（src/config/cities.ts の citySlug）。未設定時は hamamatsu
CITY=
# GA4 の測定ID（例: G-XXXXXXXXXX）。設定すると GA4 タグを読み込み、送客クリックを 'outbound_click' で送信
PUBLIC_GA4_ID=
# 送客ログの送信先（例: /api/log）。設定すると navigator.sendBeacon で送信
PUBLIC_LOG_ENDPOINT=
