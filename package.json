{
  "name": "local-city-media",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "data:mock": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-mock.mjs",
    "data:scrape": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/scrape.mjs",
