---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MobileMenu from '@/components/layout/MobileMenu.astro';
import SearchDialog from '@/components/layout/SearchDialog.astro';
import DialogController from '@/components/layout/DialogController.astro';
import OutboundTracker from '@/components/outbound/OutboundTracker.astro';
import GoogleTag from '@/components/outbound/GoogleTag.astro';
import { siteConfig } from '@/config/site.config';
import { publicPath, url } from '@/lib/url';
import { NOINDEX } from 'astro:env/server';

interface Props {
  /** ページ固有のタイトル（未指定ならサイト名のみ） */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** SNS共有画像（public/ からのパス）。未指定なら都市の既定画像 */
  image?: string;
  imageAlt?: string;
  /** og:type。トップは website、それ以外は article */
  ogType?: 'website' | 'article';
}

const { city, social } = siteConfig;
const pathname = publicPath(Astro.url.pathname);
const isHome = pathname === url('/');
const {
  title,
  description = siteConfig.description,
  image = city.ogImage,
  imageAlt = city.ogImageAlt,
  ogType = isHome ? 'website' : 'article',
} = Astro.props;
// プレビュー環境のビルド（NOINDEX）では全ページ noindex にする
const noindex = Astro.props.noindex || NOINDEX;

const fullTitle = title ? `${title}｜${siteConfig.siteName}` : `${siteConfig.siteName}｜${city.name}の暮らしとおでかけ比較メディア`;

// canonical / OGP の絶対URLは astro.config の site（= SITE_URL）から組み立てる。ドメインはコードに持たない。
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = absolute(pathname);
const ogImage = absolute(url(image));

// トップページの構造化データ（サイト名・サイト内検索）。
// Google 検索結果のサイト名は WebSite の name / alternateName と og:site_name・title から判定されるため、
// ホスティングのドメイン名（vercel.app など）ではなくサイト名を明示する。
const homeUrl = absolute(url('/'));
const websiteJsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${homeUrl}#website`,
          name: siteConfig.siteName,
          alternateName: [`${city.shortName}ガイド`, siteConfig.siteNameEn],
          url: homeUrl,
          inLanguage: 'ja',
          description: siteConfig.description,
          publisher: { '@id': `${homeUrl}#organization` },
          potentialAction: {
            '@type': 'SearchAction',
            target: `${absolute(url('/search'))}?q={search_term_string}`,
            'query-input': 'required name=search_term_string',
          },
        },
        {
          '@type': 'Organization',
          '@id': `${homeUrl}#organization`,
          name: siteConfig.siteName,
          url: homeUrl,
          logo: absolute(url('/favicon.svg')),
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang={siteConfig.lang} data-city={siteConfig.citySlug}>
  <head>
    <GoogleTag />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f4c75" />
    <title>{fullTitle}</title>
    <meta name="application-name" content={siteConfig.siteName} />
    <meta name="apple-mobile-web-app-title" content={siteConfig.siteName} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {social.twitterHandle && <meta name="twitter:site" content={social.twitterHandle} />}

    <!-- 地域メディアとしての対象エリア -->
    <meta name="geo.region" content={city.isoRegion} />
    <meta name="geo.placename" content={city.name} />
    {websiteJsonLd && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[70] focus:rounded focus:bg-white focus:px-3 focus:py-2">
      本文へスキップ
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileMenu />
    <SearchDialog />
    <DialogController />
    <OutboundTracker />
  </body>
</html>
