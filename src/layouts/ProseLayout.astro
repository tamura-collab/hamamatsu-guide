---
// 運営者情報・プライバシーポリシー等、テキスト中心のページ用レイアウト
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';

interface Props {
  title: string;
  description?: string;
  updatedAt?: string;
}
const { title, description, updatedAt } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="container-page max-w-3xl py-6 sm:py-10">
    <Breadcrumb items={[{ label: title }]} />
    <h1 class="mt-5 text-2xl font-bold sm:text-3xl">{title}</h1>
    {updatedAt && <p class="mt-2 text-xs text-muted">最終更新日：{updatedAt}</p>}
    <div
      class="mt-8 space-y-4 text-[15px] leading-loose [&_h2]:mt-10 [&_h2]:border-l-4 [&_h2]:border-brand-700 [&_h2]:pl-3 [&_h2]:text-lg [&_h2]:font-bold [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6 [&_a]:text-brand-700 [&_a]:underline"
    >
      <slot />
    </div>
  </div>
</BaseLayout>
