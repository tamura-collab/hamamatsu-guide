---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Icon from '@/components/ui/Icon.astro';
import PrBadge from '@/components/ui/PrBadge.astro';
import { articles, formatDate, type Article } from '@/data/articles';
import { categories, getCategoryHref, sections } from '@/data/categories';
import { url } from '@/lib/url';
import { siteConfig } from '@/config/site.config';
import { articleImage } from '@/lib/article-image';

// 本文（Markdown）。ファイル名 = slug
const bodies = import.meta.glob<{ compiledContent: () => string | Promise<string> }>('../../data/articles/*.md', { eager: true });

export const getStaticPaths = (() =>
  articles.map((article) => ({ params: { slug: article.slug }, props: { article } }))) satisfies GetStaticPaths;

const { article } = Astro.props as { article: Article };
const section = sections[article.section];
const category = categories.find((c) => c.slug === article.category);

const body = bodies[`../../data/articles/${article.slug}.md`];
if (!body) throw new Error(`記事本文がありません: src/data/articles/${article.slug}.md`);
// 本文中のサイト内リンク（/living など）を BASE_PATH に合わせる
const html = (await body.compiledContent()).replace(/href="\/(?!\/)/g, `href="${url('/')}`.replace(/\/$/, '') + '/');

// 記事画像（ファイルがある場合のみ）をリード文の下＝最初の見出し（h2）の直前に入れる
const image = articleImage(article);
let bodyHtml = html;
if (image) {
  const credit = image.credit
    ? `<figcaption>出典：<a href="${image.credit.url}" rel="noopener noreferrer" target="_blank">${image.credit.label}</a></figcaption>`
    : '';
  const figure = `<figure class="article-figure"><img src="${url(image.src)}" alt="${image.alt}" width="800" height="450" decoding="async">${credit}</figure>`;
  const at = bodyHtml.indexOf('<h2');
  bodyHtml = at >= 0 ? bodyHtml.slice(0, at) + figure + bodyHtml.slice(at) : figure + bodyHtml;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.excerpt,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt ?? article.publishedAt,
  author: { '@type': 'Organization', name: siteConfig.operator.name },
};
---

<BaseLayout title={article.title} description={article.excerpt}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <article class="container-page max-w-3xl py-6 sm:py-10">
    <Breadcrumb
      items={[
        { label: section.label, href: section.href },
        ...(category ? [{ label: category.title, href: getCategoryHref(category) }] : []),
        { label: '記事' },
      ]}
    />
    <header class="mt-5">
      <div class="flex items-center gap-2 text-xs text-muted">
        {article.isPr && <PrBadge />}
        <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
        {article.updatedAt && article.updatedAt !== article.publishedAt && (
          <span>更新 <time datetime={article.updatedAt}>{formatDate(article.updatedAt)}</time></span>
        )}
        <span class="inline-flex items-center gap-1"><Icon name="clock" class="size-3.5" />{article.readingMinutes}分で読めます</span>
      </div>
      <h1 class="mt-2 text-2xl leading-snug font-bold sm:text-3xl">{article.title}</h1>
      <p class="mt-3 text-muted">{article.excerpt}</p>
      <p class="mt-3 text-xs text-muted">文・調査：{siteConfig.operator.name}</p>
    </header>

    {
      article.isPr && (
        <p class="mt-6 flex items-center gap-1.5 rounded bg-surface px-2 py-1 text-[11px] leading-snug text-muted">
          <span class="shrink-0 rounded bg-white px-1 text-[10px] font-bold leading-4 ring-1 ring-line">PR</span>
          <span class="min-w-0 truncate">この記事にはアフィリエイト広告が含まれます</span>
          <a href={url('/affiliate')} class="shrink-0 underline hover:text-brand-700">広告について</a>
        </p>
      )
    }

    <div class="article-body mt-8" set:html={bodyHtml} />

    <aside class="mt-10 rounded-xl bg-surface p-4 text-xs leading-relaxed text-muted sm:p-5">
      <p>
        ※この記事の料金・営業時間・サービス内容は、{formatDate(article.updatedAt ?? article.publishedAt)}時点で各公式情報をもとに確認した内容です。
        変更されることがあるため、実際の料金や最新の条件は各公式サイトでご確認ください。
      </p>
      {
        article.sources && article.sources.length > 0 && (
          <>
            <h2 class="mt-4 text-sm font-bold text-ink">主な確認元</h2>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              {article.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener noreferrer" target="_blank" class="underline hover:text-brand-700">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </aside>

    {
      category && (
        <a
          href={url(getCategoryHref(category))}
          class="mt-6 flex items-center justify-between gap-3 rounded-xl border border-line p-4 font-bold hover:border-brand-200 hover:text-brand-700"
        >
          <span>{siteConfig.city.shortName}の{category.title}を比較する</span>
          <Icon name="chevronRight" class="size-5 shrink-0" />
        </a>
      )
    }
  </article>
</BaseLayout>
