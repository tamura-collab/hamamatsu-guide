---
// 送客計測の初期化と GA4 タグの読み込み。BaseLayout から全ページで読み込む。
import { PUBLIC_GA4_ID } from 'astro:env/client';
---

{
  PUBLIC_GA4_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${PUBLIC_GA4_ID}`} />
      <script is:inline define:vars={{ id: PUBLIC_GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', id);
      </script>
    </>
  )
}

<script>
  import { PUBLIC_GA4_ID, PUBLIC_LOG_ENDPOINT } from 'astro:env/client';
  import {
    beaconTransport,
    consoleTransport,
    ga4Transport,
    initOutboundTracking,
    memoryTransport,
    type Transport,
  } from '@/lib/tracking';

  const transports: Transport[] = [memoryTransport];
  if (import.meta.env.DEV) transports.push(consoleTransport);
  if (PUBLIC_GA4_ID) transports.push(ga4Transport);
  if (PUBLIC_LOG_ENDPOINT) transports.push(beaconTransport(PUBLIC_LOG_ENDPOINT));
  initOutboundTracking(transports);
</script>
