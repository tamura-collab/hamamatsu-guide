---
// 景表法（ステマ規制）対応の広告表記。カテゴリ・詳細ページの冒頭とカード内で使う。
import PrBadge from '@/components/ui/PrBadge.astro';
import { url } from '@/lib/url';

interface Props {
  /** ページ（またはカード）にアフィリエイトリンクが含まれるか */
  hasAffiliate: boolean;
  variant?: 'banner' | 'inline';
}

const { hasAffiliate, variant = 'banner' } = Astro.props;
const text = hasAffiliate ? 'アフィリエイト広告が含まれています（PR）' : 'アフィリエイト広告を含む場合があります（PR）';
---

{
  variant === 'banner' ? (
    <p class="flex items-center gap-1.5 rounded bg-surface px-2 py-1 text-[11px] leading-snug text-muted">
      <span class="shrink-0 rounded bg-white px-1 text-[10px] font-bold leading-4 ring-1 ring-line">PR</span>
      <span class="min-w-0 truncate">{text.replace('（PR）', '')}</span>
      <a href={url('/affiliate')} class="shrink-0 underline hover:text-brand-700">広告について</a>
    </p>
  ) : (
    <p class="flex items-center gap-1.5 text-[11px] text-amber-900">
      <PrBadge />
      {text}
    </p>
  )
}
