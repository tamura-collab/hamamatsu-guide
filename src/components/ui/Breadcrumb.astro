---
import Icon from './Icon.astro';
import { url } from '@/lib/url';
import { siteConfig } from '@/config/site.config';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}

const { city, portal } = siteConfig;
// マルチ都市展開時は親ポータル（みんなの地域ガイド）→ 都市トップ → … の順に並べる
const items: Crumb[] = [{ label: `${city.shortName}トップ`, href: '/' }, ...Astro.props.items];
const portalUrl = portal.url;

// 構造化データ（検索結果にパンくずを表示させる）
const crumbs = [...(portalUrl ? [{ label: portal.name, href: portalUrl }] : []), ...items];
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href && i < crumbs.length - 1 && { item: new URL(c.href.startsWith('http') ? c.href : url(c.href), Astro.site).href }),
  })),
};
---

<nav aria-label="パンくずリスト" class="text-xs text-muted">
  <ol class="flex flex-wrap items-center gap-1">
    {
      portalUrl && (
        <li class="flex items-center gap-1">
          <a href={portalUrl} class="hover:text-brand-700 hover:underline">
            {portal.name}
          </a>
        </li>
      )
    }
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {(i > 0 || portalUrl) && <Icon name="chevronRight" class="size-3.5 opacity-60" />}
          {item.href && i < items.length - 1 ? (
            <a href={url(item.href)} class="hover:text-brand-700 hover:underline">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="text-ink">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
