---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Icon from '@/components/ui/Icon.astro';
import PlaceCard from './PlaceCard.astro';
import OutboundLink from '@/components/outbound/OutboundLink.astro';
import CtaBlock from '@/components/outbound/CtaBlock.astro';
import AdNotice from '@/components/outbound/AdNotice.astro';
import SampleDataNotice from '@/components/ui/SampleDataNotice.astro';
import PriceNote from '@/components/info/PriceNote.astro';
import UpdateInfo from '@/components/info/UpdateInfo.astro';
import { getCategoryHref, sections, type Category } from '@/data/categories';
import { formatSpec, getPlaces, localNoteMeta, sortLocalNotes, type Place } from '@/data/places';
import { siteConfig } from '@/config/site.config';
import { url } from '@/lib/url';

interface Props {
  place: Place;
  category: Category;
}

const { place, category } = Astro.props;
const section = sections[category.section];
const isLiving = category.section === 'living';
const notes = sortLocalNotes(place.localNote);
const others = getPlaces(category.section, category.slug)
  .filter((p) => p.id !== place.id)
  .slice(0, 3);

// 複数店舗をまとめた掲載は、住所ではなく名称＋都市名で地図検索する
const mapQuery = place.chain ? `${place.name.replace(/（.*?）|エリア/g, '')} ${siteConfig.city.name}` : `${place.name} ${place.address}`;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
const telHref = place.tel ? `tel:${place.tel.replace(/-/g, '')}` : null;
// 修正依頼はお問い合わせフォームへ（対象を事前入力する）
const reportHref = `${url('/contact')}?about=${encodeURIComponent(`${place.name}（${place.id}）`)}`;
const track = { placeId: place.id, category: category.slug, section: category.section };

const description =
  place.description ?? `${siteConfig.city.name}の${place.name}（${place.genre}）の住所・営業時間・アクセス情報。`;

// 構造化データ（検索結果でのリッチ表示用）
const schemaType: Record<string, string> = {
  hotel: 'LodgingBusiness',
  gourmet: 'Restaurant',
  'rainy-day': 'TouristAttraction',
  parking: 'ParkingFacility',
  'night-bus': 'BusStation',
  gym: 'ExerciseGym',
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType[category.slug] ?? 'LocalBusiness',
  name: place.name,
  // 複数店舗をまとめた掲載はエリア表記のため、構造化データには住所を入れない
  ...(!place.chain && place.serviceType === 'store' && { address: place.address }),
  ...(place.tel && { telephone: place.tel }),
  ...(place.officialUrl && { url: place.officialUrl }),
  ...(place.description && { description: place.description }),
};

const rows = [
  { label: '住所', icon: 'mapPin', value: place.address },
  { label: '電話番号', icon: 'phone', value: place.tel },
  { label: '営業時間', icon: 'clock', value: place.hours },
  { label: 'アクセス', icon: 'train', value: place.access },
] as const;
---

<BaseLayout title={`${place.name}（${siteConfig.city.name}・${place.genre}）`} description={description}>
  {/* Web完結のサービスは店舗ではないため、店舗の構造化データを出さない */}
  {place.serviceType === 'store' && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />}

  <div class="container-page max-w-4xl py-6 sm:py-10">
    <Breadcrumb
      items={[
        { label: section.label, href: section.href },
        { label: category.title, href: getCategoryHref(category) },
        { label: place.name },
      ]}
    />

    <header class="mt-5">
      <div class="flex flex-wrap items-center gap-2">
        <a
          href={url(getCategoryHref(category))}
          class:list={[
            'inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-bold',
            isLiving ? 'bg-living-50 text-living-700' : 'bg-travel-50 text-travel-700',
          ]}
        >
          <Icon name={category.icon} class="size-3.5" />
          {category.title}
        </a>
        <span class="text-xs text-muted">{place.genre}</span>
      </div>
      <h1 class="mt-2 text-2xl leading-snug font-bold sm:text-3xl">{place.name}</h1>
      {place.description && <p class="mt-3 leading-relaxed text-muted">{place.description}</p>}
      {
        place.features.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="特徴">
            {place.features.map((f) => (
              <li class="rounded-md border border-line bg-white px-2 py-0.5 text-xs">{f}</li>
            ))}
          </ul>
        )
      }
      {place.chain && <p class="mt-2 text-xs text-muted">※複数店舗をまとめて掲載しています。住所・アクセスは代表店舗またはエリアの情報です。</p>}
    </header>

    <div class="mt-5 space-y-2">
      <AdNotice hasAffiliate={place.affiliate !== null} />
      <SampleDataNotice show={place.source === 'mock'} />
    </div>

    <!-- 送客CTA（アフィリエイトがあれば強調表示） -->
    {
      (place.affiliate || place.officialUrl) && (
        <CtaBlock place={place} category={category} placement="detail-top" size="lg" class="mt-6 sm:max-w-md" />
      )
    }

    <!-- サブアクション（スマホで押しやすい大きさ） -->
    <div class="mt-4 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
      {
        telHref && (
          <OutboundLink
            href={telHref}
            type="tel"
            {...track}
            placement="detail-actions"
            class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-line px-5 py-3 text-sm font-bold hover:border-brand-200 hover:text-brand-700"
          >
            <Icon name="phone" class="size-4" />
            電話する
          </OutboundLink>
        )
      }
      {
        place.serviceType === 'store' && (
          <OutboundLink
            href={mapUrl}
            type="map"
            {...track}
            placement="detail-actions"
            class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-line px-5 py-3 text-sm font-bold hover:border-brand-200 hover:text-brand-700"
          >
            <Icon name="mapPin" class="size-4" />
            地図で見る
          </OutboundLink>
        )
      }
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_300px]">
      <section aria-labelledby="info-title">
        <h2 id="info-title" class="text-lg font-bold">基本情報</h2>
        <dl class="mt-3 divide-y divide-line rounded-xl border border-line">
          {
            rows.map((row) => (
              <div class="grid grid-cols-[6.5rem_1fr] gap-3 px-4 py-3 text-sm sm:grid-cols-[8rem_1fr]">
                <dt class="flex items-center gap-1.5 text-xs font-semibold text-muted">
                  <Icon name={row.icon} class="size-4 shrink-0" />
                  {row.label}
                </dt>
                <dd class="break-words">
                  {row.label === '電話番号' && row.value && telHref ? (
                    <OutboundLink href={telHref} type="tel" {...track} placement="detail-info" class="text-brand-700 hover:underline">
                      {row.value}
                    </OutboundLink>
                  ) : (
                    (row.value ?? <span class="text-muted">—</span>)
                  )}
                </dd>
              </div>
            ))
          }
          <div class="grid grid-cols-[6.5rem_1fr] gap-3 px-4 py-3 text-sm sm:grid-cols-[8rem_1fr]">
            <dt class="flex items-center gap-1.5 text-xs font-semibold text-muted">
              <Icon name="external" class="size-4 shrink-0" />
              公式サイト
            </dt>
            <dd class="break-all">
              {
                place.officialUrl ? (
                  <OutboundLink href={place.officialUrl} type="official" {...track} placement="detail-info" class="text-brand-700 hover:underline">
                    {place.officialUrl}
                  </OutboundLink>
                ) : (
                  <span class="text-muted">—</span>
                )
              }
            </dd>
          </div>
        </dl>

        <h2 id="spec-title" class="mt-8 text-lg font-bold">比較ポイント</h2>
        <dl class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
          {
            category.axes.map((axis) => (
              <div class="rounded-xl border border-line px-3 py-2.5">
                <dt class="text-[11px] text-muted">{axis.label}</dt>
                <dd class="mt-0.5 font-bold">{formatSpec(axis, place.specs[axis.key])}</dd>
              </div>
            ))
          }
        </dl>
        {place.priceNote && <p class="mt-2 text-xs leading-relaxed">{place.priceNote}</p>}
        {(category.axes.some((a) => a.type === 'price') || category.notice) && <PriceNote class="mt-1" text={category.notice} />}
        <p class="mt-1 text-[11px] text-muted">「—」は未確認の項目です。</p>
      </section>

      <!-- 地域文脈（localNote）：地元目線の補足情報 -->
      <aside aria-labelledby="local-title" class="h-fit rounded-xl border border-brand-100 bg-brand-50/60 p-4">
        <h2 id="local-title" class="flex items-center gap-1.5 text-sm font-bold text-brand-800">
          <Icon name="mapPin" class="size-4" />
          地元目線のアクセスメモ
        </h2>
        {
          notes.length > 0 ? (
            <ul class="mt-3 space-y-2.5">
              {notes.map((note) => (
                <li class="flex gap-2.5">
                  <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-white text-brand-700 ring-1 ring-brand-100">
                    <Icon name={localNoteMeta[note.type].icon} class="size-4" />
                  </span>
                  <span class="text-sm leading-snug">
                    <span class="block text-[11px] text-muted">{localNoteMeta[note.type].label}</span>
                    <span class="font-semibold">{note.text}</span>
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-xs text-muted">補足情報は準備中です。</p>
          )
        }
      </aside>
    </div>

    <p class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
      <UpdateInfo />
      <span>掲載情報の確認日：<time datetime={place.updatedAt}>{place.updatedAt.replaceAll('-', '.')}</time></span>
      <a href={reportHref} class="underline hover:text-brand-700">情報の誤りを報告する</a>
    </p>
    <p class="mt-2 text-[11px] leading-relaxed text-muted">
      ※営業時間・料金等は変更される場合があります。お出かけ前に公式サイト等で最新情報をご確認ください。
    </p>

    {
      place.affiliate && (
        <div class="mt-8 rounded-2xl border border-cta-600/20 bg-cta-50/60 p-5 text-center">
          <p class="text-sm font-bold">{place.name}が気になったら</p>
          <CtaBlock place={place} category={category} placement="detail-bottom" size="lg" class="mx-auto mt-3 max-w-md" />
        </div>
      )
    }

    {
      others.length > 0 && (
        <section class="mt-12" aria-labelledby="others-title">
          <div class="mb-4 flex items-end justify-between">
            <h2 id="others-title" class="text-lg font-bold">
              ほかの{category.title}
            </h2>
            <a href={url(getCategoryHref(category))} class="text-sm font-semibold text-brand-700 hover:underline">
              一覧・比較表へ
            </a>
          </div>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((p) => (
              <li>
                <PlaceCard place={p} section={category.section} placement="detail-related" />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
