---
import Icon from '@/components/ui/Icon.astro';
import { localNoteMeta, sortLocalNotes, type LocalNote } from '@/data/places';

interface Props {
  notes: LocalNote[];
  /** 表示する最大件数（カード等で省スペースにしたい場合） */
  limit?: number;
  size?: 'sm' | 'md';
}

const { notes, limit, size = 'sm' } = Astro.props;
const items = sortLocalNotes(notes).slice(0, limit);
---

{
  items.length > 0 && (
    <ul class="flex flex-wrap gap-1.5" aria-label="地域情報">
      {items.map((note) => (
        <li
          class:list={[
            'inline-flex items-center gap-1 rounded-md font-medium',
            note.source === 'manual' ? 'bg-brand-50 text-brand-800' : 'bg-surface text-ink',
            size === 'sm' ? 'px-2 py-0.5 text-[11px]' : 'px-2.5 py-1 text-xs',
          ]}
          title={localNoteMeta[note.type].label}
        >
          <Icon name={localNoteMeta[note.type].icon} class={size === 'sm' ? 'size-3.5 shrink-0' : 'size-4 shrink-0'} />
          {note.text}
        </li>
      ))}
    </ul>
  )
}
