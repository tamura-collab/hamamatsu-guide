---
import Logo from './Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { mainNav } from '@/config/navigation';
import { siteConfig } from '@/config/site.config';
import { isActive, publicPath, url } from '@/lib/url';

const currentPath = publicPath(Astro.url.pathname);
---

<!-- 景表法（ステマ規制）対応：全ページ共通で関係性を明示（スクロール時は隠れ、ヘッダーのみ追従） -->
<p class="border-b border-line bg-surface py-1.5 text-center text-[11px] leading-snug text-muted">
  <span class="container-page block">{siteConfig.prDisclosure}</span>
</p>
<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <Logo />

    <nav aria-label="カテゴリ" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          mainNav.map((item) => {
            const active = isActive(currentPath, item.href);
            return (
              <li>
                <a
                  href={url(item.href)}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'relative rounded-md px-3 py-2 text-sm font-semibold transition-colors',
                    active ? 'text-brand-700' : 'text-ink hover:bg-surface hover:text-brand-700',
                  ]}
                >
                  {item.label}
                  {active && <span class="absolute inset-x-3 -bottom-[13px] h-0.5 rounded-full bg-brand-700" />}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-dialog-open="search-dialog"
        class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-2 text-sm text-muted transition-colors hover:border-brand-200 hover:text-brand-700 md:min-w-44"
        aria-haspopup="dialog"
      >
        <Icon name="search" class="size-[18px]" />
        <span class="hidden md:inline">サイト内を検索</span>
        <span class="sr-only md:hidden">検索を開く</span>
      </button>
      <button
        type="button"
        data-dialog-open="mobile-menu"
        class="grid size-10 place-items-center rounded-md text-ink hover:bg-surface md:hidden"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="size-6" />
        <span class="sr-only">メニューを開く</span>
      </button>
    </div>
  </div>

</header>
