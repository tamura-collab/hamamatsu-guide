---
import Logo from './Logo.astro';
import { categories, getCategoryHref, sections } from '@/data/categories';
import { policyNav } from '@/config/navigation';
import { siteConfig } from '@/config/site';
import { url } from '@/lib/url';

const year = new Date().getFullYear();
const columns = (['living', 'travel'] as const).map((key) => ({
  section: sections[key],
  items: categories.filter((c) => c.section === key),
}));
---

<footer class="mt-20 bg-brand-900 text-brand-100">
  <div class="container-page py-12">
    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <Logo inverted />
        <p class="mt-4 text-sm leading-relaxed text-brand-100/80">
          {siteConfig.city.prefecture}
          {siteConfig.city.name}の「暮らす」と「訪れる」を地元目線で比較・紹介する地域メディアです。
        </p>
      </div>

      {
        columns.map(({ section, items }) => (
          <div>
            <p class="text-sm font-bold text-white">
              <a href={url(section.href)} class="hover:underline">
                {section.label}
              </a>
            </p>
            <ul class="mt-3 space-y-2 text-sm">
              {items.map((item) => (
                <li>
                  <a href={url(getCategoryHref(item))} class="text-brand-100/80 hover:text-white">
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <p class="text-sm font-bold text-white">サイト情報</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            policyNav.map((item) => (
              <li>
                <a href={url(item.href)} class="text-brand-100/80 hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- アフィリエイト開示（景表法・ステマ規制対応） -->
    <div class="mt-10 rounded-xl border border-white/10 bg-white/5 p-4 text-xs leading-relaxed text-brand-100/80">
      <p class="font-bold text-white">広告・アフィリエイトについて</p>
      <p class="mt-1">
        当サイトは各種アフィリエイトプログラムに参加しており、紹介した商品・サービスのお申込みにより当サイトが報酬を受け取る場合があります。
        掲載順位や評価は編集部の基準に基づいて決定しており、報酬の有無によって内容を変更することはありません。
        <a href={url('/affiliate')} class="underline hover:text-white">詳しくはこちら</a>
      </p>
    </div>

    <p class="mt-8 border-t border-white/10 pt-6 text-center text-xs text-brand-100/60">
      &copy; {year} {siteConfig.operator.name}
    </p>
  </div>
</footer>
