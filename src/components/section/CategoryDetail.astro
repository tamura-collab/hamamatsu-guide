---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Icon from '@/components/ui/Icon.astro';
import PrBadge from '@/components/ui/PrBadge.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import { sections, type Category } from '@/data/categories';
import { sortedArticles } from '@/data/articles';
import { siteConfig } from '@/config/site';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const s = sections[category.section];
const isLiving = category.section === 'living';
const related = sortedArticles.filter((a) => a.category === category.slug);

// モックの比較表データ（実データは今後 DB / CMS から取得する想定）
const rows = ['A', 'B', 'C'].map((k, i) => ({
  name: `サンプル${category.title.split('・')[0]} ${k}`,
  rank: i + 1,
  isPr: i === 0,
  values: category.points.map(() => '—'),
}));
---

<BaseLayout title={`${category.title}を比較｜${siteConfig.city.name}`} description={category.summary}>
  <div class="container-page py-6 sm:py-10">
    <Breadcrumb items={[{ label: s.label, href: s.href }, { label: category.title }]} />

    <header class="mt-5 flex items-start gap-4">
      <span
        class:list={[
          'grid size-14 shrink-0 place-items-center rounded-2xl',
          isLiving ? 'bg-living-50 text-living-600' : 'bg-travel-50 text-travel-600',
        ]}
      >
        <Icon name={category.icon} class="size-8" />
      </span>
      <div>
        <h1 class="text-2xl font-bold leading-snug sm:text-3xl">
          {siteConfig.city.name}の{category.title}を比較
        </h1>
        <p class="mt-1 text-sm text-muted">{category.summary}</p>
      </div>
    </header>

    <div class="mt-6 flex gap-2 rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs leading-relaxed text-amber-900">
      <Icon name="info" class="mt-0.5 size-4 shrink-0" />
      <p>このページはモック画面です。比較データは今後掲載予定です。本ページには広告（PR）を含む場合があります。</p>
    </div>

    <section class="mt-8" aria-labelledby="compare-title">
      <h2 id="compare-title" class="text-lg font-bold">比較表（{category.count}件から抜粋）</h2>
      <p class="mt-1 text-xs text-muted">比較ポイント：{category.points.join(' / ')}</p>

      <!-- モバイルは横スクロール。先頭列を固定して見失わないようにする -->
      <div class="mt-4 overflow-x-auto rounded-xl border border-line">
        <table class="w-full min-w-[640px] border-collapse text-sm whitespace-nowrap">
          <thead class="bg-surface text-xs text-muted">
            <tr>
              <th scope="col" class="sticky left-0 bg-surface px-4 py-3 text-left font-semibold">名称</th>
              {category.points.map((p) => <th scope="col" class="px-4 py-3 text-left font-semibold">{p}</th>)}
              <th scope="col" class="px-4 py-3"><span class="sr-only">リンク</span></th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr class="border-t border-line">
                  <th scope="row" class="sticky left-0 bg-white px-4 py-3 text-left font-bold">
                    <span class="flex items-center gap-2">
                      <span class="grid size-6 place-items-center rounded-full bg-brand-700 text-[11px] text-white">{r.rank}</span>
                      {r.name}
                      {r.isPr && <PrBadge />}
                    </span>
                  </th>
                  {r.values.map((v) => (
                    <td class="px-4 py-3 text-muted">{v}</td>
                  ))}
                  <td class="px-4 py-3 text-right">
                    <span class="inline-flex cursor-not-allowed items-center gap-1 rounded-lg bg-surface px-3 py-1.5 text-xs font-semibold text-muted">
                      公式サイト（準備中）
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-[11px] text-muted">
        ※外部リンクには rel="sponsored" を付与し、広告であることを明示する運用とします。
      </p>
    </section>

    {
      related.length > 0 && (
        <section class="mt-12" aria-labelledby="detail-related">
          <h2 id="detail-related" class="mb-4 text-lg font-bold">関連記事</h2>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((a) => (
              <li>
                <ArticleCard article={a} layout="horizontal" />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
