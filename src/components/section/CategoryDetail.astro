---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import Icon from '@/components/ui/Icon.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import CompareExplorer from '@/components/compare/CompareExplorer.astro';
import AdNotice from '@/components/outbound/AdNotice.astro';
import SampleDataNotice from '@/components/ui/SampleDataNotice.astro';
import UpdateInfo from '@/components/info/UpdateInfo.astro';
import { sections, type Category } from '@/data/categories';
import { sortedArticles } from '@/data/articles';
import { getPlaces } from '@/data/places';
import { siteConfig } from '@/config/site.config';
import { url } from '@/lib/url';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const s = sections[category.section];
const isLiving = category.section === 'living';
const places = getPlaces(category.section, category.slug);
const related = sortedArticles.filter((a) => a.category === category.slug);
const hasAffiliate = places.some((p) => p.affiliate);
---

<BaseLayout title={`${siteConfig.city.name}の${category.title}を比較`} description={category.summary}>
  <div class="container-page py-6 sm:py-10">
    <Breadcrumb items={[{ label: s.label, href: s.href }, { label: category.title }]} />

    <header class="mt-5 flex items-start gap-4">
      <span
        class:list={[
          'grid size-14 shrink-0 place-items-center rounded-2xl',
          isLiving ? 'bg-living-50 text-living-600' : 'bg-travel-50 text-travel-600',
        ]}
      >
        <Icon name={category.icon} class="size-8" />
      </span>
      <div>
        <h1 class="text-2xl leading-snug font-bold sm:text-3xl">
          {siteConfig.city.name}の{category.title}
        </h1>
        <p class="mt-1 text-sm text-muted">{category.summary}</p>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
          <p class="text-xs text-muted">掲載 <strong class="text-ink">{places.length}</strong> 件</p>
          <UpdateInfo />
        </div>
      </div>
    </header>

    <div class="mt-6 space-y-2">
      <AdNotice hasAffiliate={hasAffiliate} />
      <SampleDataNotice />
    </div>

    {
      places.length === 0 ? (
        <p class="mt-10 rounded-xl border border-dashed border-line p-10 text-center text-sm text-muted">
          このカテゴリの掲載情報は準備中です。
        </p>
      ) : (
        <section aria-labelledby="compare-title" class="mt-8">
          <h2 id="compare-title" class="text-lg font-bold">
            {siteConfig.city.shortName}の{category.title}を比較する
          </h2>
          <p class="mt-1 text-xs text-muted">比較ポイント：{category.axes.map((a) => a.label).join(' / ')}</p>
          <CompareExplorer category={category} places={places} />
        </section>
      )
    }

    <aside class="mt-8 flex gap-3 rounded-xl border border-line bg-surface p-4 text-xs leading-relaxed text-muted">
      <Icon name="info" class="mt-0.5 size-4 shrink-0 text-brand-600" />
      <p>
        掲載情報は公式情報等をもとに整理したものです。営業時間・料金等は変更される場合があるため、最新情報は各公式サイトでご確認ください。
        一部のリンクはアフィリエイト広告です（<a href={url('/affiliate')} class="text-brand-700 underline">詳細</a>）。
      </p>
    </aside>

    {
      related.length > 0 && (
        <section class="mt-12" aria-labelledby="detail-related">
          <h2 id="detail-related" class="mb-4 text-lg font-bold">
            関連記事
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((a) => (
              <li>
                <ArticleCard article={a} layout="horizontal" />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
