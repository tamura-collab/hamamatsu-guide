---
import Icon from '@/components/ui/Icon.astro';
import { categories, getCategoryHref, sections } from '@/data/categories';
import { siteConfig } from '@/config/site.config';
import { url } from '@/lib/url';

const quickTags = ['gym', 'fiber', 'kids-school', 'rental-car', 'hotel', 'rainy-day']
  .map((slug) => categories.find((c) => c.slug === slug))
  .filter((c) => c !== undefined);
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white">
  <!-- 背景装飾（地図の等高線風） -->
  <svg class="pointer-events-none absolute -top-24 -right-32 size-[520px] text-brand-100" viewBox="0 0 200 200" fill="none" aria-hidden="true">
    {[90, 75, 60, 45, 30].map((r) => <circle cx="100" cy="100" r={r} stroke="currentColor" stroke-width="1" />)}
  </svg>

  <div class="container-page relative pt-8 pb-4 sm:pt-14 sm:pb-8">
    <p class="inline-flex items-center gap-1.5 rounded-full border border-brand-200 bg-white px-3 py-1 text-xs font-semibold text-brand-700">
      <Icon name="mapPin" class="size-3.5" />
      {siteConfig.city.prefecture}
      {siteConfig.city.name}（人口 {siteConfig.city.population}）
    </p>

    <h1 class="mt-4 text-[26px] font-bold leading-[1.45] tracking-tight whitespace-pre-line text-brand-900 sm:text-4xl lg:text-[44px]">
      {siteConfig.catchCopy}
    </h1>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
      {siteConfig.city.lead}
    </p>

    <form action={url('/search')} method="get" role="search" class="mt-6 max-w-xl">
      <label class="flex items-center gap-2 rounded-2xl border border-line bg-white p-1.5 pl-4 shadow-sm focus-within:border-brand-500 focus-within:ring-4 focus-within:ring-brand-100">
        <Icon name="search" class="size-5 shrink-0 text-muted" />
        <span class="sr-only">サイト内検索</span>
        <input
          type="search"
          name="q"
          required
          placeholder="例：光回線、ホテル"
          class="h-11 min-w-0 flex-1 bg-transparent text-base outline-none placeholder:text-muted/70"
        />
        <button type="submit" class="h-11 shrink-0 rounded-xl bg-brand-700 px-5 text-sm font-bold text-white hover:bg-brand-800">
          検索
        </button>
      </label>
    </form>

    <ul class="mt-4 flex flex-wrap gap-2" aria-label="よく探されるカテゴリ">
      {
        quickTags.map((c) => (
          <li>
            <a
              href={url(getCategoryHref(c))}
              class="inline-flex items-center gap-1 rounded-full bg-white px-3 py-1 text-xs font-medium text-ink ring-1 ring-line hover:text-brand-700 hover:ring-brand-200"
            >
              #{c.title.split('・')[0]}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- 2大カテゴリ導線 -->
    <div class="mt-8 grid grid-cols-2 gap-3 sm:max-w-2xl sm:gap-4">
      {
        (['living', 'travel'] as const).map((key) => {
          const s = sections[key];
          const isLiving = key === 'living';
          return (
            <a
              href={`#${key}`}
              class:list={[
                'group flex flex-col rounded-2xl p-4 text-white shadow-md transition hover:-translate-y-0.5 hover:shadow-xl sm:flex-row sm:items-center sm:gap-4 sm:p-5',
                isLiving ? 'bg-living-600 hover:bg-living-700' : 'bg-travel-500 hover:bg-travel-600',
              ]}
            >
              <span class="grid size-10 place-items-center rounded-xl bg-white/20 sm:size-12">
                <Icon name={s.icon} class="size-6" />
              </span>
              <span class="mt-3 sm:mt-0">
                <span class="block text-[10px] font-bold tracking-[0.2em] opacity-80">{s.labelEn}</span>
                <span class="flex items-center gap-1 text-lg font-bold sm:text-xl">
                  {s.label}
                  <Icon name="chevronRight" class="size-5 transition-transform group-hover:translate-x-0.5" />
                </span>
                <span class="mt-0.5 block text-[11px] leading-snug opacity-90">
                  {isLiving ? '生活インフラを比較' : '観光・移動を調べる'}
                </span>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
